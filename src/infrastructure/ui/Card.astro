---
interface Props {
  class?: string;
  padding?: 'sm' | 'md' | 'lg';
}

const { class: className = '', padding = 'md' } = Astro.props;

const paddingClasses = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
};
---

<div
  class:list={[
    'rounded-2xl bg-secondary/50 border border-light/10 backdrop-blur-sm',
    paddingClasses[padding],
    className,
  ]}
>
  <slot />
</div>
