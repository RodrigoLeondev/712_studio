---
import '@/infrastructure/styles/glass.css';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['glass-card', className]}>
  <div class="glass-card__filter"></div>
  <div class="glass-card__distortion"></div>
  <div class="glass-card__overlay"></div>
  <div class="glass-card__specular"></div>
  <div class="glass-card__content">
    <slot />
  </div>
</div>
